{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "hand-drawn top-down fantasy city map, ink and watercolour, detailed large buildings, close aerial view",
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "text, labels, lettering, words, numbers, watermark, signature, blurry, photograph, 3d render",
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "control_img": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "lineart_dense.png"
    }
  },
  "control_inv": {
    "class_type": "ImageInvert",
    "inputs": {
      "image": [
        "control_img",
        0
      ]
    }
  },
  "cn": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "xinsir_controlnet-scribble-sdxl-1.0.safetensors"
    }
  },
  "cn_apply": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "control_net": [
        "cn",
        0
      ],
      "image": [
        "control_inv",
        0
      ],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 2048,
      "height": 2048,
      "batch_size": 1
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1001,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": [
        "ckpt",
        0
      ],
      "positive": [
        "cn_apply",
        0
      ],
      "negative": [
        "cn_apply",
        1
      ],
      "latent_image": [
        "latent",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "sdxl_scale_large_dense_st080_s1001",
      "images": [
        "decode",
        0
      ]
    }
  }
}
